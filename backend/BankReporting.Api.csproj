<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Web SDK 專案：承載 Minimal API 與靜態資產輸出設定。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BankReporting.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SqlClient：SQL Server persistence；Jwt：token 發放/驗證。 -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- migration 腳本需隨發佈輸出，確保 EnsureReady 可在執行環境找到檔案。 -->
    <None Include="database/sqlserver/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
