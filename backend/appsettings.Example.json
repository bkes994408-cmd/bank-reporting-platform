{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=BankReporting;User Id=sa;Password=<change-me>;Encrypt=True;TrustServerCertificate=False"
  },
  "Persistence": {
    "Provider": "sqlserver",
    "SqlServer": {
      "ConnectionString": "",
      "MigrationsPath": "database/sqlserver"
    }
  },
  "Security": {
    "Jwt": {
      "Secret": "<required-min-32-chars>",
      "Issuer": "bank-reporting",
      "Audience": "bank-reporting-web",
      "TtlMinutes": 30
    },
    "HttpsRedirection": {
      "Enabled": true
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 1,
      "TrustedProxies": "10.0.0.2,10.0.0.3",
      "TrustedNetworks": "10.0.0.0/8,192.168.0.0/16"
    }
  },
  "Notifications": {
    "WebhookUrl": "https://example.invalid/webhook"
  },
  "Auth": {
    "Ad": {
      "Enabled": false,
      "MockUsersJson": "{}"
    }
  }
}
