{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Persistence": {
    "Provider": "json",
    "Json": {
      "FilePath": "data/app-state.json"
    },
    "SqlServer": {
      "MigrationsPath": "database/sqlserver"
    }
  },
  "Security": {
    "Jwt": {
      "Issuer": "bank-reporting",
      "Audience": "bank-reporting-web",
      "TtlMinutes": 30
    },
    "HttpsRedirection": {
      "Enabled": true
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 1,
      "TrustedProxies": "",
      "TrustedNetworks": ""
    }
  },
  "Notifications": {
    "WebhookUrl": ""
  },
  "Auth": {
    "Ad": {
      "Enabled": false,
      "Mode": "mock",
      "MockUsersJson": "{}",
      "Ldap": {
        "Host": "",
        "Port": 636,
        "UseSsl": true,
        "StartTls": false,
        "IgnoreCertificateErrors": false,
        "BindDnTemplate": "{email}",
        "UpnDomain": "",
        "ConnectTimeoutSeconds": 5,
        "OperationTimeoutSeconds": 10
      }
    }
  },
  "AllowedHosts": "*"
}
